    "@types/node": "^22.14.0",
    "@types/three": "^0.187.0",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "katex": "0.16.22",
    "lucide-static": "^1.72.0",
    "matter-js": "0.20.0",
