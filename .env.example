# Copy to .env and fill in. Names only; docs/runbook.md says what each one means.

# Required: relay | claude-cli | replay
BRAIN=

# Optional, any brain
HOST=
PORT=
LOG_LEVEL=
# report | snapshot: what a brain is told about how its last answer landed
SIGHT=
# where session logs go (default: logs). "off" writes none.
LOG_DIR=

# Required when BRAIN=claude-cli
CLAUDE_MODEL=
# Optional when BRAIN=claude-cli
CLAUDE_BIN=
BRAIN_EFFORT=
CLAUDE_WARM=
CLAUDE_MAX_WARM=
CLAUDE_WARM_IDLE_MS=
CLAUDE_RECYCLE_TOKENS=
BRAIN_TOOLS=
CLAUDE_FIRST_TOKEN_TIMEOUT_MS=
CLAUDE_IDLE_TIMEOUT_MS=

# Optional, any brain: on | off, fetch the PDFs and pages a prompt links to (default on)
READ_LINKS=

# Optional, any brain: which teaching of the prompt (one exists: column)
PROMPT_VARIANT=

# Look and fix: on | off (default on); fix passes after the draft, 0 to 2 (default 1); the three waits in ms
REVIEW=
REVIEW_PASSES=
REVIEW_DRAFT_WAIT_MS=
REVIEW_FIRST_LINE_MS=
REVIEW_PASS_MS=

# The technique library: remote | seed | none (default remote; the seed in techniques/seed is always under it)
LIBRARY=
REMOTE_BIN=
REMOTE_ACTOR=
REMOTE_ENV=
LIBRARY_ROOT=
LIBRARY_REFRESH_MS=
LIBRARY_TIMEOUT_MS=
# a folder of technique files laid over the library (the improvement loop's candidates)
LIBRARY_OVERLAY=

# The owner's own datasets for charts: none | remote (default none). DATASETS_ACTOR is the owner's account, never the Series one.
DATASETS=
DATASETS_ACTOR=
DATASETS_TIMEOUT_MS=
DATASETS_REFRESH_MS=

# v2.1 (PLAN-v2.1.md, section 8). All optional; docs/runbook.md says what each means once its package has landed.
# The live critic: on | off (default on with claude-cli), its model and effort, looks an hour at most, ms a look may take
CRITIC=
CRITIC_MODEL=
CRITIC_EFFORT=
CRITIC_PER_HOUR=
CRITIC_LOOK_MS=
# Agent mode: on | off (default off). Tools of the CLI's own it may use; connected services as name=/path/outside/this/repo.json, comma
# separated; the one folder file tools may touch; ms you have to answer a confirm control before it is a no
AGENT=
AGENT_TOOLS=
AGENT_SERVICES=
AGENT_DIR=
AGENT_ANSWER_MS=
# The steward may answer as the brain over the relay: on | off (default off)
STEWARD=
# "Keep making it better": on | off (default on when the critic is), and how many passes when nobody says (1 to 8)
REFINE=
REFINE_PASSES=
# Pictures with a prompt: on | off (default on)
UPLOADS=
# The steward's status file that /status shows (default STATUS.md)
STATUS_FILE=
# A folder OUTSIDE this repository that holds the held-out battery; unset, nothing is called held out
BATTERY_SEALED_DIR=

# Optional when BRAIN=relay
RELAY_IDLE_TIMEOUT_MS=

# Optional when BRAIN=replay
REPLAY_SCRIPT=

# Paintings. Unset or "none": no image model; a `paint` line leaves its sketch. "openai" needs a key and costs money per picture.
IMAGE_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=
IMAGE_QUALITY=
IMAGE_TIMEOUT_MS=
IMAGE_MAX_PER_SESSION=

# Optional: extra hostnames the API answers on (e.g. your Tailscale name), comma separated
TRUSTED_HOSTS=
