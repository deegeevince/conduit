{
  "name": "conduit",
  "version": "2.0.0",
  "private": true,
  "description": "A language model that answers through an animated stage instead of plain text.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=10.28.2 <11"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "dev": "concurrently --kill-others-on-fail --names server,web --prefix-colors auto \"pnpm --filter @conduit/server dev\" \"pnpm --filter @conduit/web dev\"",
    "dev:server": "pnpm --filter @conduit/server dev",
    "dev:web": "pnpm --filter @conduit/web dev",
    "build": "pnpm --filter @conduit/web build",
    "start": "pnpm --filter @conduit/server start",
    "prompt": "pnpm --filter @conduit/language exec tsx scripts/print-prompt.ts",
    "docs:language": "pnpm --filter @conduit/language exec tsx scripts/gen-reference.ts",
    "timeline": "pnpm --filter @conduit/language exec tsx scripts/timeline.ts",
    "sessions": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/sessions.ts",
    "capture": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/capture.ts",
    "golden": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/golden.ts",
    "relay": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/relay.ts",
    "server-check": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/server-check.ts",
    "agent-check": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/agent-check.ts",
    "explore": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/explore.ts",
    "library": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/library.ts",
    "improve": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/improve.ts",
    "critic-usage": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/critic-usage.ts",
    "lessons": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/lessons.ts",
    "taste": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/taste.ts",
    "parity": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/parity.ts",
    "wall-bench": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/wall-bench.ts",
    "smoke": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/smoke.ts",
    "voice-check": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/voice-check.ts",
    "audit": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/audit.ts",
    "audit-log": "pnpm --filter @conduit/server exec tsx --env-file-if-exists=../.env src/tools/audit.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
