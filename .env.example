# Copy to .env and fill in. Names only; docs/runbook.md says what each one means.

# Required: relay | claude-cli | codex-cli | replay
BRAIN=

# Optional, any brain
HOST=
PORT=
LOG_LEVEL=
# report | snapshot: what a brain is told about how its last answer landed
SIGHT=
# where session logs go (default: logs). "off" writes none.
LOG_DIR=

# Required when BRAIN=claude-cli
CLAUDE_MODEL=
# Optional when BRAIN=claude-cli
CLAUDE_BIN=
BRAIN_EFFORT=
CLAUDE_WARM=
CLAUDE_MAX_WARM=
CLAUDE_WARM_IDLE_MS=
CLAUDE_RECYCLE_TOKENS=
BRAIN_TOOLS=
CLAUDE_FIRST_TOKEN_TIMEOUT_MS=
CLAUDE_IDLE_TIMEOUT_MS=

# Optional, any brain: on | off, fetch the PDFs and pages a prompt links to (default on)
READ_LINKS=

# Optional, any brain: openverse | none (default none). Photographs for the `image` parts of a mock-up, found by their words (the only thing that leaves the machine), credited at their foot. The owner switches it on in the run command; it is never committed on. Kept in DATA_DIR/cache/pictures unless PICTURES_DIR says otherwise
PICTURES=
PICTURES_DIR=

# Optional, any brain: which teaching of the prompt (one exists: column)
PROMPT_VARIANT=

# Look and fix: on | off (default on); fix passes after the draft, 0 to 2 (default 1); the three waits in ms
REVIEW=
REVIEW_PASSES=
REVIEW_DRAFT_WAIT_MS=
REVIEW_FIRST_LINE_MS=
REVIEW_PASS_MS=

# The technique library: seed | none (default seed: the files in techniques/seed)
LIBRARY=
# a folder of technique files laid over the library (the improvement loop's candidates)
LIBRARY_OVERLAY=

# v2.1 (PLAN-v2.1.md, section 8). All optional; docs/runbook.md says what each means once its package has landed.
# The live critic: on | off (default on with claude-cli), its model and effort, looks an hour at most, ms a look may take
CRITIC=
CRITIC_MODEL=
CRITIC_EFFORT=
CRITIC_PER_HOUR=
CRITIC_LOOK_MS=
# v3 art. A `draw` the shelf misses is drawn in the background on your own `claude` login (Fable, else Opus) and put in place of its placeholder.
# ART_MAKER: one (one careful call, about 1 to 2 minutes and about $0.50 cost-equivalent) | staged (the loop that looks at its picture; needs Chrome and the web dev server) | off (a miss stays a placeholder).
# Default one with claude-cli, off with the others. ART_PER_HOUR: drawings an hour (default 12). None are started when the usage throttle says near the cap.
ART_MAKER=
ART_PER_HOUR=
# v3 (WS5). Fill ahead and verify: write the parts of a document that are only named, in the background, and check each before it is offered.
# on | off (default on with claude-cli); parts written at once; the second check's model and effort; parts per check; most parts a conversation writes ahead
AHEAD=
AHEAD_PARALLEL=
AHEAD_VERIFY_MODEL=
AHEAD_VERIFY_EFFORT=
AHEAD_BATCH=
AHEAD_LIMIT=
# The brain is an agent: on | off (default on with BRAIN=claude-cli). Tools of the CLI's own it may use; connected services as
# name=/path/outside/this/repo.json, comma separated, and the word `chrome` for your own Chrome (Claude in Chrome, in tabs of its own: see
# docs/runbook.md); the one folder file tools may touch; ms you have to answer a confirm control before it is a no
AGENT=
AGENT_TOOLS=
AGENT_SERVICES=
AGENT_DIR=
AGENT_ANSWER_MS=
# The steward may answer as the brain over the relay: on | off (default off)
STEWARD=
# "Keep making it better": on | off (default on when the critic is), and how many passes when nobody says (1 to 8)
REFINE=
REFINE_PASSES=
# Pictures with a prompt: on | off (default on)
UPLOADS=
# The steward's status file that /status shows (default STATUS.md)
STATUS_FILE=
# A folder OUTSIDE this repository that holds the held-out battery; unset, nothing is called held out
BATTERY_SEALED_DIR=

# Optional when BRAIN=relay
RELAY_IDLE_TIMEOUT_MS=

# Optional when BRAIN=replay
REPLAY_SCRIPT=

# Optional: extra hostnames the API answers on (e.g. your Tailscale name), comma separated
TRUSTED_HOSTS=

# v2.1 ops. Where the owner's data lives, outside the repository (default ~/Library/Application Support/Conduit)
DATA_DIR=
# Tailscale logins allowed through `tailscale serve`, comma separated. Read yours from GET /api/whoami over the tailnet. Never commit it.
OWNER_LOGINS=
# Cost-equivalent dollars per rolling hour at which the critic and `pnpm lessons` back off (from 80%); unset: off
USAGE_HOURLY_CAP=
# Other checkouts whose logs/ are copied into DATA_DIR on the first start, comma separated
MIGRATE_FROM=

# Subscription only: BRAIN=codex-cli (Codex CLI 0.169+; run codex login first).
# Choose a model available to your ChatGPT account; no API key is accepted.
CODEX_MODEL=
CODEX_BIN=
# Whole-turn deadline, including tools (default 180000 ms)
CODEX_TIMEOUT_MS=
# on | off, default on: Codex's native read-only web search
CODEX_WEB=
